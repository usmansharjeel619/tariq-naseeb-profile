---
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/manrope";
import "../styles/profile.css";

interface Props { title: string; description: string; image?: string; noindex?: boolean; }
const { title, description, image = "/profile-og.jpg", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const personSchema = {
  "@context": "https://schema.org", "@type": "Person", name: "Tariq Naseeb",
  jobTitle: "Director", url: Astro.site, image: imageUrl,
  worksFor: { "@type": "Organization", name: "YIWU TARIQ International Trading Co. Ltd.", url: "https://yiwutariq.com" },
  email: "Tariqnaseeb@yiwutariq.com", telephone: "+97477308308", address: { "@type": "PostalAddress", streetAddress: "Room 902, Building 4, Block A, Zhongfu Plaza", addressLocality: "Yiwu City", addressRegion: "Zhejiang", addressCountry: "CN" },
  knowsAbout: ["International trading", "Sourcing", "Procurement", "Business development", "Commercial partnerships"],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A1B2B" /><meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/brand/mark-color.png" type="image/png" />
    <meta property="og:type" content="profile" /><meta property="og:site_name" content="Tariq Naseeb" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={imageUrl} />
    <title>{title}</title><script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body><a class="skip-link" href="#main-content">Skip to main content</a><slot /></body>
</html>
